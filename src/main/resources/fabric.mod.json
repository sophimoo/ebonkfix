{
  "schemaVersion": 1,
  "id": "ebonkfix",
  "version": "${version}",
  "name": "Ebonkfix",
  "description": "ebonkfix for meteor for oldest anarchy server in mc",
  "authors": [
    "Sophimoo"
  ],
  "contact": {
    "repo": "https://github.com/sophimoo/ebonkfix"
  },
  "icon": "assets/ebonkfix/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "me.sophimoo.ebonkfix.Ebonkfix"
    ]
  },
  "mixins": [
    "ebonkfix.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "90,140,90"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
